PORT=3000

# Configuration mutations are disabled by default. Both settings are required,
# and POST /api/configuration must originate from a loopback address.
# NODE_ENV=development
ENABLE_LOCAL_CONFIGURATION_WRITES=false

# Phase 1 persistence and Python subprocess safeguards.
# Optional absolute path. If omitted, backend/data/energy_platform.sqlite is used.
# ENERGY_DB_PATH=/absolute/path/to/energy_platform.sqlite
EXECUTION_LOG_RETENTION_DAYS=30
MODEL_RUN_LOG_RETENTION_DAYS=30
PYTHON_PROCESS_TIMEOUT_MS=30000
PYTHON_MAX_OUTPUT_BYTES=1048576
GENERATION_PROCESS_RETRIES=0
MARKET_PROCESS_RETRIES=0
WEATHER_API_TIMEOUT_MS=10000

# Market Agent. OPENAI_API_KEY remains supported for compatibility.
MARKET_AI_API_KEY=
MARKET_AI_BASE_URL=
MARKET_AI_MODEL=gpt-5-mini

# Bounded OpenAI Decision Agent. Without a key/cost estimate, an explicitly
# activated integrated demo may use its labeled deterministic fallback.
DECISION_AI_API_KEY=
DECISION_AI_BASE_URL=https://openrouter.ai/api/v1
DECISION_AI_MODEL=gpt-5-mini
# Explicit operator estimate for one bounded request, used to enforce the
# configured simulation cost ceiling. No provider price is assumed in code.
DECISION_AI_ESTIMATED_REQUEST_COST_MINOR_UNITS=
